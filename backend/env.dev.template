# Development Environment Variables Template
# Copy these values to Google Cloud Secret Manager or Cloud Run environment variables
# When deploying to: bld-cebu-portal-dev

# Database (Cloud SQL - Development)
# Format: postgresql://postgres:PASSWORD@/DATABASE_NAME?host=/cloudsql/CONNECTION_NAME
DATABASE_URL=postgresql://postgres:PASSWORD@/bld_portal_dev?host=/cloudsql/bld-cebu-portal-dev:asia-southeast1:bld-portal-db-dev

# JWT Secrets (Store in Secret Manager as: dev-jwt-secret, dev-jwt-refresh-secret)
# Generate strong random strings: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=GENERATE_STRONG_RANDOM_STRING
JWT_REFRESH_SECRET=GENERATE_STRONG_RANDOM_STRING

# API Configuration
API_PREFIX=api/v1
PORT=4000

# Frontend URL (Development domain)
FRONTEND_URL=https://dev.yourdomain.com

# Node Environment
NODE_ENV=production

# BunnyCDN Storage (REQUIRED for production photo/QR storage)
# Canonical names: BUNNYCDN_* (aliases BUNNY_CDN_* also supported)
# When unconfigured, development falls back to data URLs
# Storage zone name from BunnyCDN dashboard
BUNNYCDN_STORAGE_ZONE=your-storage-zone
# Access key (password) from BunnyCDN storage zone settings
BUNNYCDN_ACCESS_KEY=your-access-key
# Pull zone URL (CDN domain) from BunnyCDN dashboard, e.g., https://your-zone.b-cdn.net
BUNNYCDN_CDN_URL=https://your-zone.b-cdn.net
# Optional: Storage hostname for regional endpoints (default: storage.bunnycdn.com)
# For Singapore region: sg.storage.bunnycdn.com
# BUNNYCDN_STORAGE_HOSTNAME=storage.bunnycdn.com
